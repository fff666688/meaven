<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="Dao.EmployeeDao">
    <!--开启二级缓存-->
    <cache/>

    <resultMap id="EmployeeMapper" type="com.aaa.Employee">
        <id property="empId" column="emp_id"/>
        <result property="empName" column="emp_name"/>
        <result property="hireDate" column="hire_date"/>
        <!--gender/age/dept/job/salary/phone/email 列名和属性名一致，autoMapping 自动映射-->
    </resultMap>


    <insert id="batchAdd">
        INSERT INTO employee (emp_name,gender,age,dept,job,salary,hire_date,phone,email) VALUES
        <foreach collection="list" item="emp" separator=",">
            (#{emp.empName},#{emp.gender},#{emp.age},#{emp.dept},#{emp.job},#{emp.salary},#{emp.hireDate},#{emp.phone},#{emp.email})
        </foreach>
    </insert>


    <update id="update">
        update employee
        <set>
            <if test="empName!=null and empName!=''">
                emp_name=#{empName},
            </if>
            <if test="gender!=null and gender!=''">
                gender=#{gender},
            </if>
            <if test="age!=null">
                age=#{age},
            </if>
            <if test="dept!=null and dept!=''">
                dept=#{dept},
            </if>
            <if test="job!=null and job!=''">
                job=#{job},
            </if>
            <if test="salary!=null">
                salary=#{salary},
            </if>
            <if test="hireDate!=null and hireDate!=''">
                hire_date=#{hireDate},
            </if>
            <if test="phone!=null and phone!=''">
                phone=#{phone},
            </if>
            <if test="email!=null and email!=''">
                email=#{email},
            </if>
        </set>
        where emp_id=#{empId}
    </update>


    <delete id="batchDelete">
        delete from employee where emp_id in
        <foreach collection="list" item="id" separator="," open="(" close=")">
            #{id}
        </foreach>
    </delete>

    <!--where: 条件成立时自动补 where 关键字，并把第一个多余的 and 去掉-->
    <select id="selectByCondition" resultMap="EmployeeMapper">
        select * from employee
        <where>
            <if test="empName != null and empName != ''">
                and emp_name = #{empName}
            </if>
            <if test="gender != null and gender != ''">
                and gender = #{gender}
            </if>
            <if test="dept != null and dept != ''">
                and dept = #{dept}
            </if>
            <if test="job != null and job != ''">
                and job = #{job}
            </if>
        </where>
    </select>


    <select id="selectByCondition2" resultMap="EmployeeMapper">
        select * from employee
        <where>
            <choose>
                <when test="empName!=null and empName!=''">
                    and emp_name = #{empName}
                </when>
                <when test="dept!=null and dept!=''">
                    and dept =#{dept}
                </when>
                <otherwise>
                    and 1=1
                </otherwise>
            </choose>
        </where>
    </select>


    <select id="selectByCondition3" resultMap="EmployeeMapper">
        select * from employee
        <where>
            <choose>
                <when test="empName!=null and empName!=''">
                    and emp_name = #{empName}
                </when>
                <when test="dept!=null and dept!=''">
                    and dept =#{dept}
                </when>
                <otherwise>
                    and 1=1
                </otherwise>
            </choose>
        </where>
    </select>



    <select id="selectByCondition4" resultMap="EmployeeMapper">
        select * from employee
        <trim prefix="where" prefixOverrides="and|or" >
            <if test="empName!=null and empName!=''">
                and emp_name = #{empName}
            </if>
            <if test="dept!=null and dept!=''">
                or dept =#{dept}
            </if>
        </trim>
    </select>

    <select id="selectByCondition5" resultMap="EmployeeMapper">
        select * from employye where emd_id=#{id}
    </select>

    <!-- ==================== #{} 和 ${} 的区别 ==================== -->

    <!-- 1. #{}：预编译占位符，值是参数，整串当一个"值"，防注入 -->
    <select id="selectByNameHash" resultMap="EmployeeMapper">
        select * from employee where emp_name = #{empName}
    </select>

    <!-- 2. ${}：字符串拼接，值直接拼进 SQL（字符串要自己加单引号） -->
    <select id="selectByNameDollar" resultMap="EmployeeMapper">
        select * from employee where emp_name = '${empName}'
    </select>

    <!-- 3. 排序用 #{}：编译成 order by ?，排的是常量，排序不生效 -->
    <select id="orderByHash" resultMap="EmployeeMapper">
        select * from employee order by #{column}
    </select>

    <!-- 4. 排序用 ${}：字段名拼进 SQL，排序生效（字段名没法预编译，只能用它） -->
    <select id="orderByDollar" resultMap="EmployeeMapper">
        select * from employee order by ${column}
    </select>

    <!-- 5. 模糊查询用 #{}：推荐，注意 % 要放在 #{} 外面 -->
    <select id="searchByLikeHash" resultMap="EmployeeMapper">
        select * from employee where emp_name like concat('%', #{keyword}, '%')
    </select>

    <select id="selectByName" resultType="com.aaa.Employee">
        select * from employee where emp_name = '${name}'
    </select>

    <!-- 6. 模糊查询用 ${}：有注入风险 -->
<select id="searchByLikeDollar" resultMap="EmployeeMapper">
select * from employee where emp_name like '%${keyword}%'
</select>

    <!-- 7. 模糊查询标准写法：% 交给 concat，占位符只占"值"的位置 -->
    <select id="selectByLikeName" resultMap="EmployeeMapper">
        select * from employee where emp_name like concat('%', #{name}, '%')
    </select>
    <select id="selectById" resultMap="EmployeeMapper">
        select * from employee where emp_id=#{id}
    </select>

</mapper>