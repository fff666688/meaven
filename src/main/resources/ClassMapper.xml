<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--namespace:命令空间。现在可以随便起名。
后续需要和dao的名称一致。
-->
<mapper namespace="Dao.ClazzDao">

    <resultMap id="ClazzMapper" type="com.aaa.Clazz">
        <id column="c_id" property="cid"/>
        <result column="c_name" property="cname"/>
        <result column="teacher_id" property="teacherId"/>
        <!--association: 一对一或多对一的映射关系
        property: 表示对应对象的属性名
        javaType: 表示对象的类型
        -->
        <association property="teacher" javaType="com.aaa.Teacher">
            <id column="t_id" property="tid"/>
            <result column="t_name" property="tname"/>
        </association>
        <!--collection表示一对多的标签
        ofType:表示集合中存放的类型
        -->
        <collection property="students" ofType="com.aaa.Student">
            <id property="sid" column="s_id"/>
            <result property="sname" column="s_name"/>
        </collection>
    </resultMap>

    <select id="getById" resultMap="ClazzMapper">
        select *
        from class c
                 inner join teacher t
                            on c.teacher_id = t.t_id
                 inner join student s
                            on c.c_id=s.class_id
        where c.c_id = #{id}
    </select>

</mapper>